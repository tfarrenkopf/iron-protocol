# ============================================
# IRON PROTOCOL - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# SUPABASE CONFIGURATION (Required)
# ============================================
# These are obtained from your Supabase project settings:
# Dashboard > Settings > API

# Your Supabase project URL
# Example: https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Your Supabase anonymous/public API key (safe to expose in client)
# Found in: Dashboard > Settings > API > anon/public key
VITE_SUPABASE_PUBLISHABLE_KEY=

# Your Supabase project ID (optional - for reference)
# This is the subdomain of your project URL
VITE_SUPABASE_PROJECT_ID=

# ============================================
# GOOGLE ANALYTICS (Optional)
# ============================================
# Google Analytics 4 Measurement ID
# Format: G-XXXXXXXXXX
# VITE_GA_MEASUREMENT_ID=

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
# Enable/disable features for different environments
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_ERROR_REPORTING=true

# ============================================
# NOTES FOR PRODUCTION
# ============================================
# 1. Never commit .env file to version control
# 2. Set these in Vercel project settings:
#    - Settings > Environment Variables
# 3. The VITE_ prefix is required for Vite to expose
#    variables to the client bundle
# 4. Keep service role key SECRET - never use in client
